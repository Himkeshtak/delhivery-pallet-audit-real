.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ultralytics/

# Real datasets are downloaded reproducibly and are not redistributed.
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated runs stay local; only compact selected release checkpoints are committed.
runs/**
weights/**
artifacts/**
!runs/.gitkeep
!weights/.gitkeep
!weights/releases/
!weights/releases/*.pt
!artifacts/.gitkeep

.env
.env.*
!.env.example
*.onnx
*.engine
*.pt
*.pth
!weights/releases/*.pt
