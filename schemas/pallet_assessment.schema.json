{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Himkeshtak/delhivery-pallet-audit-real/schemas/pallet_assessment.schema.json",
  "title": "Pallet assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "created_at_utc",
    "frame_id",
    "track_id",
    "pose",
    "checks",
    "overall_verdict",
    "overall_confidence",
    "reasoning"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "frame_id": {"type": "string", "minLength": 1},
    "track_id": {"type": "string", "minLength": 1},
    "pose": {"$ref": "#/$defs/pose"},
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/check"}
    },
    "overall_verdict": {"$ref": "#/$defs/verdict"},
    "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "calibration_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "verdict": {"enum": ["PASS", "FAIL", "MANUAL_REVIEW"]},
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "x_m",
        "y_m",
        "theta_deg",
        "visible_face",
        "covariance_xy_m2",
        "theta_std_deg",
        "confidence",
        "reprojection_rmse_px",
        "reasons"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "x_m": {"type": ["number", "null"]},
        "y_m": {"type": ["number", "null"]},
        "theta_deg": {"type": ["number", "null"], "minimum": -180, "exclusiveMaximum": 180},
        "visible_face": {"type": ["string", "null"]},
        "covariance_xy_m2": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          }
        },
        "theta_std_deg": {"type": ["number", "null"], "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reprojection_rmse_px": {"type": ["number", "null"], "minimum": 0},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "name", "scope", "verdict", "confidence", "reason", "evidence"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^SOP-PAL-03-[1-8]$"},
        "name": {"type": "string"},
        "scope": {"enum": ["VERIFIABLE", "PARTIAL", "NOT_VERIFIABLE"]},
        "verdict": {"$ref": "#/$defs/verdict"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "evidence": {"type": "object"}
      }
    }
  }
}

